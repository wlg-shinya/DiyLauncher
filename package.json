{
  "name": "diy-launcher",
  "version": "2.2.0",
  "description": "",
  "type": "module",
  "appConfig": {
    "productName": "DiyLauncher",
    "identifier": "com.welovegamesinc.diylauncher"
  },
  "scripts": {
    "start": "npm run tauri dev",
    "dev": "npm run generate-config-default-xml && vite",
    "build": "npm run sync-settings && npm run generate-config-default-xml && tsc && vite build",
    "package": "npm run clean && tauri build",
    "clean": "rm -rf dist src-tauri/target/release",
    "tauri": "tauri",
    "sync-settings": "node scripts/sync-settings.js",
    "generate-config-default-xml": "node scripts/generate-config-default-xml.js"
  },
  "keywords": [],
  "author": "wlg-shinya",
  "license": "MIT",
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3",
    "vite": "^8.1.5"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "fast-xml-parser": "^5.3.2",
    "iconv-lite": "^0.7.0"
  }
}
