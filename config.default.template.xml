<config>
    <head>
        <!-- 
            同ディレクトリにある icon.ico を差し替えることで好きなアイコンに変更できます。
            DiyLauncher.exe 自体のアイコンを差し替えたものにすることはできませんので、
            exe のショートカットを用意してそちらのアイコンを変えることで代用してください。
        -->

        <!-- width, height は起動するアプリのウィンドウサイズです -->
        <width>800</width>
        <height>840</height>

        <!-- ここの内容がそのまま head に適用されます -->
        <!-- {{PACKAGE_VERSION}} はこのアプリ自体のバージョンが表示されます -->
        <meta charset="UTF-8" />
        <title>DIY Launcher {{PACKAGE_VERSION}}</title>
        <style>
            body { 
                background-color: #222; 
                color: #fff; 
                font-family: @FONT_FAMILY@; 
                padding: 20px;
            }
            .grid-container { 
                display: grid; 
                grid-template-columns: 1fr 1fr; 
                gap: 10px; 
                margin-bottom: 20px;
            }
            .launcher-btn { 
                padding: 15px; 
                cursor: pointer; 
                background: #444; 
                color: white; 
                border: 1px solid #666; 
                border-radius: 5px;
                font-size: 14px;
                text-align: left;
                transition: background 0.2s;
            }
            .launcher-btn:hover:not(:disabled) { 
                background: #555; 
            }
            .launcher-btn:disabled {
                opacity: 0.4;
                cursor: not-allowed;
                background: #333 !important;
                border-color: #444;
            }

            #console-log {
                width: 100%;
                height: 220px;
                background-color: #1e1e1e;
                color: #00ff00;
                border: 1px solid #444;
                padding: 10px;
                font-family: monospace;
                box-sizing: border-box;
                border-radius: 4px;
                resize: vertical;
            }

            .section {
                background: #333;
                padding: 15px;
                border-radius: 5px;
                border: 1px solid #444;
                margin-bottom: 20px;
            }
            .section label {
                font-weight: bold;
                margin-right: 5px;
                font-size: 14px;
            }
            .section input[type="text"],
            .section input[type="number"],
            .section select {
                background: #111;
                border: 1px solid #555;
                color: #fff;
                padding: 5px 8px;
                border-radius: 3px;
                margin-right: 15px;
                font-size: 14px;
            }
            .section input[type="radio"],
            .section input[type="checkbox"] {
                accent-color: #4da6ff;
                cursor: pointer;
                margin: 0;
                width: 14px;
                height: 14px;
                flex-shrink: 0;
            }

            .form-row {
                display: flex;
                flex-wrap: wrap;
                align-items: center;
                gap: 16px;
                margin-bottom: 12px;
            }
            .form-item {
                display: inline-flex;
                align-items: center;
                gap: 6px;
            }
            .form-item > label {
                margin-right: 0;
                line-height: 1;
            }
            .option-group {
                display: inline-flex;
                align-items: center;
                gap: 12px;
                background: #2a2a2a;
                padding: 6px 10px;
                border-radius: 4px;
                border: 1px solid #444;
                box-sizing: border-box;
            }
            .option-group label {
                font-weight: normal;
                margin-right: 0;
                cursor: pointer;
                display: inline-flex;
                align-items: center;
                gap: 5px;
                line-height: 1;
            }
        </style>
    </head>
    <body>
        <!-- ここの内容がそのまま body に適用されます -->

        <!-- data-command で記述されたコマンドをOSで実行します -->
        <div class="grid-container">
            <button class="launcher-btn" data-command="@APP_TEXT_EDITOR_CMD@">
                @APP_TEXT_EDITOR_LABEL@
            </button>
            <!-- data-command-detach を true に設定するとプロセスから切り離してこのアプリを終了しても data-command が終了しなくなります。デフォルトは false で、アプリ終了とともに data-command を終了させます -->
            <button class="launcher-btn" 
                data-command="@APP_UTIL_CMD@" 
                data-command-detach="true"
            >
                @APP_UTIL_LABEL@
            </button>
        </div>

        <div class="section">
            <div style="margin-bottom: 10px;">
                <!-- data-var で記述された文字列は {{}} で囲むことでその要素の値を参照できます -->
                <label>Target:</label>
                <input type="text" data-var="target_host" />
                <label>Count:</label>
                <input type="number" data-var="ping_count" value="3" style="width: 50px;" />
            </div>

            <!-- data-command-log-id で記述された id を持つ <textarea>/<input> にコマンド出力ログを表示します -->
            <!-- data-command-log-file で記述されたファイルパスを作成してログを出力します -->
            <!-- data-command-log-mode でログの出力を上書き(overwrite)するか追記(append)するかを指定できます。(デフォルトは overwrite ) -->
            <!-- data-command-pid を設定すると、@KILL コマンドで指定してプロセスを終了できます -->
            <button class="launcher-btn" style="width: 100%;"
                title="ping {{target_host}} -n {{ping_count}}"
                data-command="ping {{target_host}} @PING_COUNT_OPT@ {{ping_count}}"
                data-command-log-id="console-log"
                data-command-log-file="logs/ping_{{target_host}}.log"
                data-command-log-mode="overwrite"
                data-command-pid="target-console-log"
            >
                ▶ ping {{target_host}} -n {{ping_count}}
            </button>
        </div>

        <div class="section">
            <div class="form-row">
                <!-- ドロップダウンリスト: 選択中の option の value が {{env_type}} に入ります -->
                <div class="form-item">
                    <label for="env-select">環境:</label>
                    <select id="env-select" data-var="env_type" style="margin-right: 0;">
                        <option value="dev">開発 (dev)</option>
                        <option value="stage">検証 (stage)</option>
                        <option value="prod">本番 (prod)</option>
                    </select>
                </div>

                <!-- ラジオボタン: 同じ data-var を指定すると選択中の value が {{log_level}} に入ります -->
                <div class="form-item">
                    <label>ログレベル:</label>
                    <span class="option-group">
                        <label><input type="radio" data-var="log_level" name="log_level" value="INFO" checked />INFO</label>
                        <label><input type="radio" data-var="log_level" name="log_level" value="WARN" />WARN</label>
                        <label><input type="radio" data-var="log_level" name="log_level" value="DEBUG" />DEBUG</label>
                    </span>
                </div>

                <!-- チェックボックス: ON のときは value の文字列、OFF のときは空文字が {{dry_run}} に入ります -->
                <div class="form-item">
                    <span class="option-group">
                        <label><input type="checkbox" data-var="dry_run" value="--dry-run" />ドライラン (--dry-run)</label>
                    </span>
                </div>
            </div>

            <button class="launcher-btn" style="width: 100%;"
                title="echo [{{env_type}}] level={{log_level}} {{dry_run}}"
                data-command="echo [{{env_type}}] level={{log_level}} {{dry_run}}"
                data-command-log-id="console-log"
                data-command-pid="target-console-log"
            >
                ▶ echo [{{env_type}}] level={{log_level}} {{dry_run}}
            </button>
        </div>

        <!-- data-command-output-var に記述された文字列は {{}} で囲むことで data-command の結果を参照できます -->
        <!-- data-auto-click を true に設定すると起動時およびホットリロード時にクリックイベントが発生します -->
        <!-- {{NOW}} で現在時刻(年月日_時分秒)を文字列で得られます -->
        <div class="grid-container">
            <div class="section" style="margin-bottom: 0; display: flex; align-items: center;">
                <label>hostname:</label>
                <span
                    data-command="hostname"
                    data-command-output-var="hostname"
                    data-auto-click="true"
                >
                    {{hostname}}
                </span>
            </div>

            <button class="launcher-btn"
                title="echo {{NOW}}"
                data-command="echo {{NOW}}"
                data-command-log-id="console-log"
                data-command-pid="target-console-log"
            >
                現在時刻(NOW)を文字列で表示
            </button>
        </div>

        <!-- data-command に @KILL を指定すると、指定した data-command-pid の処理を終了できます -->
        <textarea id="console-log" readonly></textarea>
        <button class="launcher-btn"
            style="margin-top: 8px;"
            data-command="@KILL:target-console-log"
        >
            処理をキャンセル
        </button>
    </body>
</config>